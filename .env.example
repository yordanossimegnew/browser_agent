# Copy to .env and fill in. Never commit .env.
ANTHROPIC_API_KEY=sk-ant-...

# Optional overrides
AGENT_MODEL=claude-opus-5-5
AGENT_EFFORT=high            # low | medium | high | xhigh | max
AGENT_MAX_STEPS=20           # model calls per run
BROWSER_HEADLESS=true        # false = watch the browser window
BROWSER_TIMEOUT_MS=20000
SEARCH_URL=https://search.brave.com/search?q={query}
BROWSER_BLOCKED_DOMAINS=     # comma separated, e.g. facebook.com,x.com
BROWSER_ALLOW_PRIVATE_HOSTS=false   # keep false: blocks localhost / LAN (SSRF guard)
MAX_CONCURRENT_RUNS=2
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/browser_agent
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/browser_agent_test   # used only by pytest
LOG_LEVEL=INFO
